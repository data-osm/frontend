{
    "/api": {
        "target": "http://127.0.0.1:8000",
        "secure": false,
        "changeOrigin": true,
        "logLevel": "debug",
        "cookieDomainRewrite": {
            "127.0.0.1": "localhost"
        }
    },
    "/auth": {
        "target": "http://127.0.0.1:8000",
        "secure": false,
        "changeOrigin": true,
        "logLevel": "debug",
        "cookieDomainRewrite": {
            "127.0.0.1": "localhost"
        }
    },
    "/icons": {
        "target": "http://127.0.0.1:8000",
        "secure": false,
        "changeOrigin": true,
